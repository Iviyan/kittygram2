{
	"info": {
		"name": "Kittygram API",
		"description": "Полная коллекция запросов к Kittygram API. Охватывает аутентификацию (djoser + JWT), управление пользователями, котами, достижениями, поездками и остановками. Запустите «Register user» → «Get JWT token» — токен сохранится автоматически.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url",      "value": "http://127.0.0.1:8000", "description": "Базовый URL сервера" },
		{ "key": "token",         "value": "",                       "description": "Access-токен (заполняется автоматически после Get JWT token)" },
		{ "key": "refresh_token", "value": "",                       "description": "Refresh-токен (заполняется автоматически после Get JWT token)" },
		{ "key": "cat_id",        "value": "1",                      "description": "ID кота для запросов detail/update/delete" },
		{ "key": "achievement_id","value": "1",                      "description": "ID достижения" },
		{ "key": "trip_id",       "value": "1",                      "description": "ID поездки" },
		{ "key": "stop_id",       "value": "1",                      "description": "ID остановки" }
	],
	"item": [
		{
			"name": "Auth",
			"description": "Регистрация, JWT-аутентификация и управление аккаунтом через djoser.",
			"item": [
				{
					"name": "Register user",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"TestPass123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/users/",
							"host": ["{{base_url}}"],
							"path": ["auth", "users", ""]
						}
					}
				},
				{
					"name": "Get JWT token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var j = pm.response.json();",
									"if (j.access)  pm.collectionVariables.set('token',         j.access);",
									"if (j.refresh) pm.collectionVariables.set('refresh_token',  j.refresh);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"TestPass123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/jwt/create/",
							"host": ["{{base_url}}"],
							"path": ["auth", "jwt", "create", ""]
						}
					}
				},
				{
					"name": "Refresh JWT token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var j = pm.response.json();",
									"if (j.access) pm.collectionVariables.set('token', j.access);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/jwt/refresh/",
							"host": ["{{base_url}}"],
							"path": ["auth", "jwt", "refresh", ""]
						}
					}
				},
				{
					"name": "Verify JWT token",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/jwt/verify/",
							"host": ["{{base_url}}"],
							"path": ["auth", "jwt", "verify", ""]
						}
					}
				},
				{
					"name": "Get current user (me)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {
							"raw": "{{base_url}}/auth/users/me/",
							"host": ["{{base_url}}"],
							"path": ["auth", "users", "me", ""]
						}
					}
				},
				{
					"name": "Update current user (me)",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Authorization", "value": "Bearer {{token}}"},
							{"key": "Content-Type",  "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"first_name\": \"Иван\",\n  \"last_name\": \"Тестов\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/users/me/",
							"host": ["{{base_url}}"],
							"path": ["auth", "users", "me", ""]
						}
					}
				},
				{
					"name": "Change password",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{token}}"},
							{"key": "Content-Type",  "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"current_password\": \"TestPass123!\",\n  \"new_password\": \"NewPass456!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/users/set_password/",
							"host": ["{{base_url}}"],
							"path": ["auth", "users", "set_password", ""]
						}
					}
				},
				{
					"name": "Delete account (me)",
					"request": {
						"method": "DELETE",
						"header": [
							{"key": "Authorization", "value": "Bearer {{token}}"},
							{"key": "Content-Type",  "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"current_password\": \"TestPass123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/users/me/",
							"host": ["{{base_url}}"],
							"path": ["auth", "users", "me", ""]
						}
					}
				},
				{
					"name": "(error) Register — weak password",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"testuser2\",\n  \"password\": \"123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/users/",
							"host": ["{{base_url}}"],
							"path": ["auth", "users", ""]
						}
					}
				},
				{
					"name": "(error) Get token — wrong credentials",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"wrongpassword\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/jwt/create/",
							"host": ["{{base_url}}"],
							"path": ["auth", "jwt", "create", ""]
						}
					}
				}
			]
		},
