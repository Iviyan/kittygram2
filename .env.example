# Секретный ключ Django. Обязательно замените на уникальное значение в production.
# Генерация: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=secret-key

# Режим отладки. В production должен быть False.
# Допустимые значения: True / False
DEBUG=True

# Список разрешённых хостов через запятую без пробелов.
# Пример для production: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1
